# Copy to .env and fill in. Gitignored -- never commit a real token here.

PORT=4200
FRAME_HOST_ORIGIN=https://staging.secure.fluz.app

# A real Fluz OAuth access token with the CREATE_VIRTUALCARD scope, for the
# account that owns VIRTUAL_CARD_ID below. In a real integration this is
# minted by your own backend's existing OAuth flow -- this example just
# reads it from the environment to stand in for that. Never send this
# token to the browser; server.js keeps it server-side and only ever
# forwards the short-lived clientToken/loadToken pair it mints in exchange.
#
# Your Fluz integration contact needs to have allow-listed this example's
# own origin (http://localhost:4200) for your app_id before frames will
# render -- see docs/partner-integration-guide.md's Prerequisites section.
ACCESS_TOKEN=

# A real, ACTIVE virtual card id owned by that same account.
VIRTUAL_CARD_ID=
